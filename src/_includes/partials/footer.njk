<footer class="footer">
  <div class="container footer__grid">
    <div>
      <a href="/" class="brand brand--light">
        <img src="/assets/img/logo-mark.svg" alt="" width="40" height="40">
        <span class="brand__text"><b>PEDALLA</b><small>KAYSERİ</small></span>
      </a>
      <p class="footer__about">{{ site.aciklama }}</p>
      <p class="footer__badge">{{ site.bagliKurum }} bünyesinde</p>
    </div>
    <div>
      <h3>Sayfalar</h3>
      <ul>
        <li><a href="/hakkimizda/">Hakkımızda</a></li>
        <li><a href="/etkinlikler/">Yaklaşan Etkinlikler</a></li>
        <li><a href="/faaliyetler/">Geçmiş Faaliyetler</a></li>
        <li><a href="/uyelik/">Üyelik Başvurusu</a></li>
        <li><a href="/kvkk/">KVKK Aydınlatma Metni</a></li>
      </ul>
    </div>
    <div>
      <h3>İletişim</h3>
      <ul>
        {% if site.iletisim.eposta %}<li><a href="mailto:{{ site.iletisim.eposta }}">{{ site.iletisim.eposta }}</a></li>{% endif %}
        {% if site.iletisim.telefon %}<li><a href="tel:{{ site.iletisim.telefon | replace(' ', '') }}">{{ site.iletisim.telefon }}</a></li>{% endif %}
        {% if site.iletisim.adres %}<li>{{ site.iletisim.adres }}</li>{% endif %}
      </ul>
      <div class="social">
        {% if site.sosyal.instagram %}
        <a href="https://www.instagram.com/{{ site.sosyal.instagram }}/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.8a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg>
          <span>@{{ site.sosyal.instagram }}</span>
        </a>
        {% endif %}
        {% if site.sosyal.youtube %}<a href="{{ site.sosyal.youtube }}" target="_blank" rel="noopener">YouTube</a>{% endif %}
        {% if site.sosyal.strava %}<a href="{{ site.sosyal.strava }}" target="_blank" rel="noopener">Strava</a>{% endif %}
      </div>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {{ "" | yil }} {{ site.ad }}. Tüm hakları saklıdır.</span>
    <a href="/admin/" rel="nofollow">Yönetici Girişi</a>
  </div>
</footer>
