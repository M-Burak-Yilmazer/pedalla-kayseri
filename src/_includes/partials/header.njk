{% set nav = [
  { url: "/", ad: "Ana Sayfa" },
  { url: "/hakkimizda/", ad: "Hakkımızda" },
  { url: "/etkinlikler/", ad: "Etkinlikler" },
  { url: "/faaliyetler/", ad: "Faaliyetler" },
  { url: "/iletisim/", ad: "İletişim" }
] %}
<header class="header" id="ust">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="{{ site.ad }} ana sayfa">
      <img src="/assets/img/logo-mark.svg" alt="" width="40" height="40">
      <span class="brand__text"><b>PEDALLA</b><small>KAYSERİ</small></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="menu" aria-label="Menüyü aç">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="menu" aria-label="Ana menü">
      <ul>
        {% for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url or (item.url != "/" and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.ad }}</a></li>
        {% endfor %}
      </ul>
      <a href="/uyelik/" class="btn btn--primary btn--sm">Üye Ol</a>
    </nav>
  </div>
</header>
